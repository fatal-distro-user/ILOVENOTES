{
  "name": "ilovenotes",
  "productName": "ILOVENOTES",
  "version": "0.1.0",
  "description": "Local-first hybrid notes, infinite canvas, PDF annotator, paint studio and flipbook animator.",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "author": "ILOVENOTES",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "npm run build:electron && concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env ILN_DEV_URL=http://localhost:5173 electron .\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run build:web",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build:desktop": "npm run build:web && npm run build:electron && electron-builder --linux AppImage deb --publish never",
    "build:desktop:win": "npm run build:web && npm run build:electron && electron-builder --win nsis --publish never",
    "build:desktop:mac": "npm run build:web && npm run build:electron && electron-builder --mac dmg --x64 --arm64 --publish never",
    "build:all": "npm run build:web && npm run build:electron && electron-builder --linux AppImage deb --win nsis --publish never",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tiptap/extension-code-block-lowlight": "^3.35.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/extension-subscript": "^3.35.0",
    "@tiptap/extension-superscript": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extension-task-item": "^3.35.0",
    "@tiptap/extension-task-list": "^3.35.0",
    "@tiptap/extension-typography": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ag-psd": "^34.2.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "d3-force": "^3.0.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "immer": "^11.2.10",
    "jsdom": "^31.0.1",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.77.0",
    "minisearch": "^7.2.0",
    "nanoid": "^6.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tesseract.js": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1",
    "workbox-window": "^7.4.1",
    "zustand": "^5.1.0"
  },
  "desktopName": "ilovenotes.desktop"
}
